# Environment Variables — AI Interior Planner
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_DB=aip_db
POSTGRES_USER=aip_user
POSTGRES_PASSWORD=aip_pass

# Backend
DATABASE_URL=postgresql://aip_user:aip_pass@localhost:5432/aip_db
JWT_SECRET=supersecretjwtkey_changeme_in_production
JWT_EXPIRES_IN=7d
PORT=4000

# Frontend
VITE_API_BASE_URL=http://localhost:4000

# Cloudinary (optional, leave empty to use local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
